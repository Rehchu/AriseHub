.dev.vars
# Postgres password, used to run migrations from the CLI. `supabase link` is
# broken on 2.112.0 (its API-keys call fails schema validation), so commands
# take --db-url instead, built from this.
.supabase-db-password
.supabase-db-url
.wrangler/
supabase/.temp/
*.log
.DS_Store
.open-next/

# tsc incremental cache — machine-local, not a build output worth tracking
tsconfig.tsbuildinfo

# Throwaway harnesses used to measure layout/CSS without booting the app.
# One of these got committed and served publicly from /public.
__tmp_*
__probe.*
public/__probe.*

# Subagent scratch directories.
.scratch*/

# Approval deck: the screenshots are of the live site, so they carry real member
# names and faces, and the .pptx embeds them. Regenerate with tools/build-deck.mjs.
/AriseHub-Overview.pptx
/tools/deck-shots/

# Print agent TLS material — a private key, generated per machine.
/tools/print-agent/certs/
