{
  // Tiny scheduler for AriseHub.
  //
  // Cloudflare Cron fires a Worker's `scheduled` handler, which OpenNext's
  // generated worker doesn't expose. Rather than patch a generated file on every
  // build, this separate Worker just calls AriseHub's cron endpoints on schedule.
  // It also means changing the schedule doesn't require rebuilding the whole app.
  //
  // JSONC, not TOML, and the file name is load-bearing — the same trap that used
  // to live in arise-it-portal/worker. Wrangler looks for wrangler.json, then
  // wrangler.jsonc, then wrangler.toml, and each name is a find-up that walks
  // every ancestor directory before the next name is tried. With only a
  // wrangler.toml here, the .jsonc search reached the repo root first, so any
  // wrangler command run from this directory without -c silently operated on
  // AriseHub's config — deploying the main Worker from whatever stale
  // .open-next/ happened to be lying around. A .jsonc in this directory wins
  // that search, so the plain command is correct.
  "name": "arisehub-cron",
  "main": "index.js",
  "compatibility_date": "2025-03-25",

  // UTC. 23:00 = 5pm CST / 6pm CDT (evening before). 13:00 Sat = 7am CST.
  "triggers": {
    "crons": ["0 23 * * *", "0 13 * * 6"]
  },

  "vars": {
    "APP_URL": "https://arisehub.myfaithtech.com"
  }
}
