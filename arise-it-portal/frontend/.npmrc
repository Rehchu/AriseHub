# @vitejs/plugin-react 6 lists @rolldown/plugin-babel as an OPTIONAL peer, whose
# own @babel/plugin-transform-runtime peer npm 7+ cannot auto-place, so a strict
# install errors (ERESOLVE). This project uses plain react() with the default
# oxc transform — not the Babel / React Compiler path — so those optional Babel
# peers are genuinely unused. Relax peer resolution here to keep `npm install`
# and `npm ci` reproducible.
legacy-peer-deps=true
