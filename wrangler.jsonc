{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arisehub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Public values only. Secrets (SUPABASE_SERVICE_ROLE_KEY, VAPID_PRIVATE_KEY)
    // are set with `wrangler secret put` and never live in this file.
    "NEXT_PUBLIC_IT_PORTAL_URL": "https://itportal.myfaithtech.com"
  }
}
